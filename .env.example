# Core
ENVIRONMENT=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_tracker
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Sessions and CORS
COOKIE_NAME=finance_session
SESSION_MAX_AGE_SECONDS=86400
CSRF_ENABLED=true
CSRF_COOKIE_NAME=finance_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false

# Redis (future phases)
REDIS_URL=redis://redis:6379/0
REPORT_CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=200
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_LIMIT=100
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_REPORTING_LIMIT=400
RATE_LIMIT_REPORTING_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_FAIL_CLOSED=true
RATE_LIMIT_REPORTING_FAIL_CLOSED=false

# Frontend
# Keep /api/v1 suffix to match frontend api client route usage.
VITE_API_BASE_URL=http://localhost:8000/api/v1
